# --- Secrets ---
.env
.env.*
!.env.example

# --- Single-VM deploy: generated on the target VM by
# scripts/deploy-single-vm.sh, holds real secrets/domain — never the
# checked-in infra/garage/garage.toml or infra/Caddyfile.template.
infra/garage.toml
infra/Caddyfile

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
*.egg-info/
# Regenerated by `python -c '...app.openapi()...'` (README, CI) — the
# intermediate step feeding packages/api-client, not itself committed.
apps/api/openapi.json

# --- Node ---
node_modules/
.next/
out/
*.tsbuildinfo
.turbo/

# --- Media / transcode output ---
transcoded/
uploads/
*.m3u8
*.m4s
*.ts.tmp

# --- Local data ---
*.db
*.sqlite3
minio-data/
postgres-data/
# LocalStorageAdapter's on-disk root (STORAGE_BACKEND=local) — payment
# proofs and other uploads written during dev/test runs, never committed.
apps/api/var/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# Playwright (apps/web/e2e) — artefacts, never sources
test-results/
playwright-report/
blob-report/
.playwright/
