# Copy to .env and fill in. Nothing here is a working secret.

# --- Core ---
ENVIRONMENT=local           # local | dev | staging | production
DEBUG=true
API_PORT=8010

# Signs access and refresh tokens.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# The web app's own origin — embedded in certificate QR codes (REQ-CRED-02),
# which need an absolute URL a phone camera can resolve outside the BFF.
PUBLIC_WEB_URL=http://localhost:3010
# This API's own public origin — used only for the Payfast webhook's
# notify_url (03 §5.7), since that's a server-to-server call from
# Payfast, not a browser call subject to the BFF-only routing every
# other frontend call uses.
API_PUBLIC_URL=http://localhost:8010

# --- Database ---
# No default, deliberately. The app refuses to start rather than guessing and
# silently connecting somewhere unintended.
#
# The app connects as app_user, not ttli: ttli is the Postgres bootstrap
# superuser and superusers bypass row-level security unconditionally, FORCE
# or not. app_user is created by the baseline migration with no elevated
# privileges, so RLS actually binds it.
DATABASE_URL=postgresql+asyncpg://app_user:app_user_local_dev@localhost:5452/ttli
# Alembic runs DDL and needs the superuser; sync driver, same database.
DATABASE_URL_SYNC=postgresql+psycopg2://ttli:ttli_local_dev@localhost:5452/ttli
# Password the baseline migration assigns to app_user. Must match the
# credential half of DATABASE_URL above.
APP_DB_PASSWORD=app_user_local_dev

# --- Redis ---
REDIS_URL=redis://localhost:6399/0

# --- Auth ---
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
MAGIC_LINK_MINUTES=15
PASSWORD_RESET_MINUTES=30
# Lifetime of the short-lived JWTs covering an MFA login challenge and an
# MFA enrolment in progress.
MFA_PENDING_MINUTES=5
MFA_ENROLL_MINUTES=10
# Issuer label shown in authenticator apps.
MFA_ISSUER_NAME=TTLI

# Seeded by migration, refused in production by check_production_safety().
BREAK_GLASS_ADMIN_ENABLED=true
BREAK_GLASS_ADMIN_EMAIL=admin@ttli.local
BREAK_GLASS_ADMIN_PASSWORD=change-me-locally

# --- Field encryption ---
# 32 bytes, base64. Held in Key Vault in production, never in the database.
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=
# Separate key. Deriving one from the other defeats the point of both.
BLIND_INDEX_KEY=

# --- Object storage ---
STORAGE_BACKEND=local       # local | s3 | azure
# Filesystem root for the local adapter (relative to apps/api).
STORAGE_LOCAL_ROOT=var/storage
# Must match infra/docker-compose.yml's GARAGE_DEFAULT_ACCESS_KEY/SECRET_KEY
# (dependency-upgrade sprint G, MinIO -> Garage) — Garage requires the
# GK<24 hex>/<64 hex> key format, unlike MinIO's arbitrary strings.
S3_ENDPOINT_URL=http://localhost:9140
S3_ACCESS_KEY=GKb9c32ff7b3db35e902fd29f7
S3_SECRET_KEY=43e555c82c4dd74d5d783f61510d2badd718f9937d9e4c326c25628527d5280c
S3_REGION=af-south-1
# Only read when STORAGE_BACKEND=azure. No local emulator is provisioned.
AZURE_STORAGE_CONNECTION_STRING=

# --- Virus scanning (04 §3, REQ-BYPASS-08) ---
CLAMAV_HOST=localhost
CLAMAV_PORT=3410

# --- Media pipeline (06 §3, 02 §5.4/5.5) ---
# Leave blank to auto-resolve from PATH / common install locations.
FFMPEG_PATH=
FFPROBE_PATH=
PLAYBACK_URL_EXPIRY_SECONDS=300
MAX_CONCURRENT_VIDEO_SESSIONS=2
HEARTBEAT_MAX_PLAYBACK_RATE=2.0

# --- Email ---
SMTP_HOST=localhost
SMTP_PORT=1145
EMAIL_FROM=no-reply@ttli.local

# --- Card checkout: Payfast (03 §5.2/5.7) ---
# No sandbox account exists yet (01 §1.4's Phase 0 outstanding list) —
# leaving these blank is what keeps card checkout correctly *disabled*.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# --- Podcast Spotify metadata lookup (REQ-STORE-04) ---
# No Spotify Developer app registered yet — leaving these blank means the
# admin curation UI falls back to manual entry, not an error.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Web Push (01 §5.9) ---
# Self-generated, not a third party's credential — nothing external
# blocks this one. Generate a real pair for local testing:
#   python -c "
#   from py_vapid import Vapid02
#   from cryptography.hazmat.primitives import serialization
#   import base64
#   v = Vapid02(); v.generate_keys()
#   pub = v.public_key.public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)
#   priv = v.private_key.private_numbers().private_value.to_bytes(32, 'big')
#   b64 = lambda b: base64.urlsafe_b64encode(b).rstrip(b'=').decode()
#   print('VAPID_PUBLIC_KEY=' + b64(pub)); print('VAPID_PRIVATE_KEY=' + b64(priv))
#   "
# Blank means push sends are skipped, the same graceful-degradation shape
# as Payfast/Spotify above.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=INFO
