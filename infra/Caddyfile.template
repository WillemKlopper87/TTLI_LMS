# Generated by scripts/deploy-single-vm.sh — {DOMAIN} is substituted with
# the real domain(s) at deploy time. Caddy's whole job here is narrow:
# terminate TLS (automatic via Let's Encrypt, zero cert-renewal cron to
# maintain — the reason this project uses Caddy over nginx+certbot for a
# single VM, see docs/research/single-vm-deployment.md §4) and forward
# everything to the web container, which is already the single BFF
# chokepoint the whole app is built around (apps/web/app/api/bff/) — so
# there's no CORS or multi-origin question to solve at this layer.
#
# One block per line handles every tenant hostname pointed at this VM
# (the base domain plus each organisation's own custom domain) — the app
# resolves the actual tenant from the Host header itself
# (core/tenancy.py), this proxy doesn't need to know which is which.
{DOMAIN} {
	reverse_proxy web:3010

	encode gzip zstd

	# Caddy already sends security headers Next's own proxy.ts also sets
	# (nosniff, etc.) — redundant is fine, a proxy-level default that
	# survives even if a future change to proxy.ts's matcher regresses
	# it is worth the duplication.
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
	}

	log {
		output file /data/access.log {
			roll_size 50mb
			roll_keep 10
		}
	}
}
