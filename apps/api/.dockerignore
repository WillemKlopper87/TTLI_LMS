# The image installs from requirements.txt and copies only src/alembic —
# everything below is either irrelevant to runtime or actively harmful to
# bake in (secrets, generated media, the local venv).
.venv/
.env
.env.*
var/
tests/
scripts/
# Un-ignored for Dockerfile.pi only (scripts/deploy-pi.sh runs the seed
# scripts inside the container) — the real Dockerfile never references
# this path, so re-including it here has no effect on that build.
!scripts/*.py
openapi.json
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/
